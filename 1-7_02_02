#!/bin/bash
# Раскладывает файлы из ~/workspace/inbox по подкаталогам по расширению
DIR="${1:-$HOME/workspace/inbox}"

if [ ! -d "$DIR" ]
then
    echo "Каталог $DIR не найден."
    exit 1
fi

moved=0
for file in "$DIR"/*
do
    [ -f "$file" ] || continue
    name=$(basename "$file")
    if [[ "$name" == *.* ]]
    then
        ext="${name##*.}"
    else
        ext="other"
    fi
    mkdir -p "$DIR/$ext"
    mv -n "$file" "$DIR/$ext/"
    ((moved++))
done
