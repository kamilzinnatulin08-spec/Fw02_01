# =====================================================================
# 02.02 №3. Анализ процессов
# =====================================================================
bash3() {
  echo ">>> 02.02 №3: process_analyzer.sh в $U_HOME"

  put "$U_HOME/process_analyzer.sh" 755 <<'PUT_END'
#!/bin/bash
# Анализ процессов Linux. Все значения определяются во время запуска.
export LC_ALL=C

current_user=$(whoami)

# user, pid, %cpu, %mem, команда - по строке на процесс, без заголовка
ps_data=$(ps -eo user:32=,pid=,pcpu=,pmem=,comm=)

process_count=$(echo "$ps_data" | wc -l)
user_count=$(echo "$ps_data" | awk -v u="$current_user" '$1 == u' | wc -l)
other_count=$((process_count - user_count))

# $1 - заголовок, $2 - номер столбца (3 = CPU, 4 = MEM), $3 - подпись
show_top_process()
{
    local title="$1"
    local column="$2"
    local label="$3"
    local line pid name value

    line=$(echo "$ps_data" | sort -k"$column" -nr | head -n 1)
    pid=$(echo "$line" | awk '{print $2}')
    value=$(echo "$line" | awk -v c="$column" '{print $c}')
    name=$(echo "$line" | awk '{$1=$2=$3=$4=""; sub(/^ +/, ""); print}')

    echo "$title"
    echo "PID: $pid"
    echo "Процесс: $name"
    echo "$label: ${value}%"
}

echo "========================================"
echo "АНАЛИЗ ПРОЦЕССОВ LINUX"
echo "========================================"
echo "Всего процессов: $process_count"
echo "Процессов пользователя: $user_count"
echo "Остальных процессов: $other_count"
echo
show_top_process "Наибольшая загрузка CPU:" 3 "CPU"
echo
show_top_process "Наибольшее потребление памяти:" 4 "MEM"
echo "========================================"
PUT_END

  echo "Готово. Запуск: ./process_analyzer.sh"
}

# =====================================================================
# 02.01 №2. Локальное журналирование rsyslog (задание 13)
# =====================================================================
syslog2() {
  need_root
  echo ">>> 02.01 №2: rsyslog"
  dnf install -y rsyslog || die "не удалось установить rsyslog"

  cat > /etc/rsyslog.d/lab2.conf <<'EOF'
# Практическая №2: собственные правила
local1.*          /var/log/lab2-local1.log
local0.warning    /var/log/lab2-local0.log
EOF

  touch /var/log/lab2-local0.log /var/log/lab2-local1.log
  rsyslogd -N1 || die "ошибка в конфигурации rsyslog"
  systemctl enable --now rsyslog
  systemctl restart rsyslog
  echo "Готово: правила в /etc/rsyslog.d/lab2.conf"
}

# =====================================================================
# 02.01 №4. Nginx + rsyslog
# =====================================================================
nginx4() {
  need_root
  local X="${1:-}"
  [ -n "$X" ] || die "укажите фамилию латиницей: sudo bash $0 nginx4 ivanov"
  X="$(echo "$X" | tr 'A-Z' 'a-z')"
  echo "$X" | grep -Eq '^[a-z0-9-]+$' || die "фамилия: только латиница/цифры/дефис"

  echo ">>> 02.01 №4: nginx.$X.lab"
  dnf install -y nginx rsyslog || die "не удалось установить пакеты"

  # --- rsyslog: приём сообщений nginx на 127.0.0.1:514/udp ---
  if ! ss -uln | grep -q ':514 '
  then
    cat > /etc/rsyslog.d/20-nginx-input.conf <<'EOF'
module(load="imudp")
input(type="imudp" address="127.0.0.1" port="514")
EOF
  fi

  # --- rsyslog: два правила ---
  cat > /etc/rsyslog.d/30-nginx.conf <<'EOF'
if ($programname == 'mynginx') then /var/log/mynginx.log
if ($programname == 'nginx') then /var/log/allnginx.log
EOF

  # --- nginx: access_log основного сервера через syslog ---
  [ -f /etc/nginx/nginx.conf.orig ] || cp /etc/nginx/nginx.conf /etc/nginx/nginx.conf.orig
  if ! grep -q 'access_log syslog:' /etc/nginx/nginx.conf
  then
    sed -i -E 's#^([[:space:]]*)access_log[[:space:]]+/var/log/nginx/access\.log[^;]*;#\1access_log syslog:server=127.0.0.1:514,facility=local0,tag=nginx;#' \
      /etc/nginx/nginx.conf
  fi

  # --- виртуальный сервер ---
  mkdir -p "/var/www/nginx.$X.lab"
  echo "<h1>nginx.$X.lab</h1>" > "/var/www/nginx.$X.lab/index.html"

  cat > "/etc/nginx/conf.d/nginx.$X.lab.conf" <<EOF
server {
    listen 80;
    server_name nginx.$X.lab;

    root /var/www/nginx.$X.lab;
    index index.html;

    access_log syslog:server=127.0.0.1:514,facility=local0,tag=mynginx;
}
EOF

  # --- имя сайта через /etc/hosts ---
  grep -q "nginx.$X.lab" /etc/hosts || echo "127.0.0.1 nginx.$X.lab" >> /etc/hosts

  # --- применение (конфигурация проверяется перед перезапуском) ---
  nginx -t       || die "ошибка в конфигурации nginx"
  rsyslogd -N1   || die "ошибка в конфигурации rsyslog"
  systemctl enable --now rsyslog
  systemctl restart rsyslog
  systemctl enable --now nginx
  systemctl reload nginx

  echo "Готово: http://nginx.$X.lab/  (логи: /var/log/mynginx.log, /var/log/allnginx.log)"
}

# =====================================================================
case "${1:-}" in
  bash1)   bash1 ;;
  bash2)   bash2 ;;
  bash3)   bash3 ;;
  syslog2) syslog2 ;;
  nginx4)  nginx4 "${2:-}" ;;
  all)
    [ -n "${2:-}" ] || die "sudo bash $0 all <фамилия>"
    bash1; bash2; bash3; syslog2; nginx4 "$2"
    ;;
  *)
    sed -n '2,13p' "$0"
    exit 1
    ;;
esac
