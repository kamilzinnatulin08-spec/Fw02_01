#!/bin/bash
# =====================================================================
# practice.sh - все практические работы в одном файле (БЕЗ проверок)
#
#   bash practice.sh bash1            02.02 №1: info/workspace/backup/find_files/organizer/assistant
#   bash practice.sh bash2            02.02 №2: create_lab2.sh, create_data_2_3.sh, lab2.sh
#   bash practice.sh bash3            02.02 №3: process_analyzer.sh
#   sudo bash practice.sh syslog2     02.01 №2: rsyslog, правила local0/local1
#   sudo bash practice.sh nginx4 <фамилия>   02.01 №4: nginx + rsyslog
#   sudo bash practice.sh all <фамилия>      всё сразу
#
# 02.01 №1 (journalctl) - теория, готовить там нечего.
# =====================================================================
set -u

# ---- чьи домашний каталог и права использовать ----
if [ "$(id -u)" -eq 0 ] && [ -n "${SUDO_USER:-}" ]; then
  U_NAME="$SUDO_USER"
  U_HOME="$(getent passwd "$SUDO_USER" | cut -d: -f6)"
else
  U_NAME="$(id -un)"
  U_HOME="$HOME"
fi

die()       { echo "Ошибка: $*" >&2; exit 1; }
need_root() { [ "$(id -u)" -eq 0 ] || die "эта тема запускается от root (sudo bash $0 ...)"; }

# команда от имени обычного пользователя (если запущено через sudo)
as_user() {
  if [ "$(id -u)" -eq 0 ] && [ "$U_NAME" != "root" ]; then
    runuser -u "$U_NAME" -- env HOME="$U_HOME" "$@"
  else
    "$@"
  fi
}

# put <файл> <права> < содержимое   (файл принадлежит обычному пользователю)
put() {
  as_user tee "$1" > /dev/null
  as_user chmod "$2" "$1"
}

