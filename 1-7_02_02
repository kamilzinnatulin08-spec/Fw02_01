#!/bin/bash
cd "$HOME/bash_lab2" || { echo "Нет каталога ~/bash_lab2"; exit 1; }

analyze_directory()
{
    local dir="$1"
    local files=0
    local directories=0
    local files_empty=0
    local files_full=0
    local item

    if [ -z "$dir" ]
    then
        echo "Ошибка: не указан каталог"
        return 1
    fi

    if [ ! -d "$dir" ]
    then
        echo "Ошибка: каталог '$dir' не существует"
        return 1
    fi

    echo "Анализ: $dir"

    for item in $(find "$dir" -mindepth 1 | sort -V)
    do
        if [ -d "$item" ]
        then
            echo "Каталог: $item"
            ((directories++))
        elif [ -f "$item" ]
        then
            echo "Файл: $item"
            ((files++))

            if [ -s "$item" ]
            then
                ((files_full++))
            else
                ((files_empty++))
            fi
        fi
    done

    echo "Всего файлов: $files"
    echo "Всего каталогов: $directories"
    echo "Всего пустых файлов: $files_empty"
    echo "Всего не пустых файлов: $files_full"
}

analyze_directory data
echo
analyze_directory data_2
echo
analyze_directory data_3
PUT_END

